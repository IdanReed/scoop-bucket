{
    "version": "0.9.5-idan.5",
    "description": "Terminal workspace manager for AI coding agents (IdanReed's Herdr build with pane, tab, spaces, and agents modes)",
    "homepage": "https://github.com/IdanReed/herdr",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/IdanReed/herdr/releases/download/v0.9.5-idan.5/herdr-windows-x86_64.zip",
            "hash": "55684f691b320faf60258ed7113392f1cf0c169f214477a40a6e8925e731cd2b"
        }
    },
    "bin": "herdr.exe",
    "post_install": [
        "# Install the herdr hooks for Claude Code and Codex. Each install is",
        "# idempotent and is skipped when that agent's config folder is missing.",
        "foreach ($agent in @('claude', 'codex')) {",
        "    try {",
        "        $out = (& \"$dir\\herdr.exe\" integration install $agent 2>&1 | Out-String).Trim()",
        "        if ($LASTEXITCODE -eq 0) { Write-Host \"herdr: $agent integration installed\" }",
        "        else { Write-Host \"herdr: $agent integration skipped: $out\" }",
        "    } catch {",
        "        Write-Host \"herdr: $agent integration skipped: $_\"",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/IdanReed/herdr",
        "regex": "releases/tag/v([\\d.]+-[a-z]+\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/IdanReed/herdr/releases/download/v$version/herdr-windows-x86_64.zip"
            }
        }
    }
}
